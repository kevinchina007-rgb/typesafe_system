TRAVEL_PUBLIC_HOST=your-domain.example.com
TRAVEL_PUBLIC_SCHEME=https
TRAVEL_PUBLIC_FRONTEND_ORIGIN=https://your-domain.example.com
TRAVEL_PUBLIC_BACKEND_ORIGIN=https://your-domain.example.com
TRAVEL_ALLOWED_ORIGINS=https://your-domain.example.com

TRAVEL_DB_URL=jdbc:postgresql://127.0.0.1:5432/travel_platform
TRAVEL_DB_DRIVER=org.postgresql.Driver
TRAVEL_DB_USER=postgres
TRAVEL_DB_PASSWORD=replace-with-a-strong-password

TRAVEL_SESSION_COOKIE_DOMAIN=your-domain.example.com
TRAVEL_SESSION_COOKIE_SECURE=true
TRAVEL_SESSION_COOKIE_SAMESITE=lax

TRAVEL_PAYMENT_LINK_SECRET=replace-with-a-long-random-secret
TRAVEL_AVATAR_UPLOAD_ROOT=E:\typesafe\template\backend\uploads\avatars
TRAVEL_CONTENT_UPLOAD_ROOT=E:\typesafe\template\backend\uploads\content
