# Copy this file to backend/advertising-ai.env and fill in your real values.
# The backend startup script loads backend/advertising-ai.env automatically if it exists.

# Text generation provider used by GenerateAdvertisementTextCandidatesPlanner
POLLINATIONS_API_KEY=replace-with-your-pollinations-key

# Image generation provider used by GenerateAdvertisementImageCandidatesPlanner
PARATERA_API_KEY=replace-with-your-paratera-key
PARATERA_BASE_URL=https://llmapi.paratera.com
PARATERA_TEXT_MODEL=GLM-4-Flash
PARATERA_IMAGE_MODEL=GLM-CogView3-Flash
